# Copia este archivo a .env.development.local (NO a .env.local: Vite lo cargaría también en la compilación de producción).
# Sin estas variables la app funciona en modo "solo este dispositivo". No las configures en Vercel hasta el hito 5.
# Valores de Supabase local: `supabase status -o env` (API_URL y ANON_KEY). Nunca pongas aquí la llave service_role.
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=
